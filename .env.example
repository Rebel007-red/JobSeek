# Copy to .env and fill in. Never commit .env.

# Browser (login) - Supabase project settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server side only (Netlify Function in dev, Databricks scripts)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
# Optional: defaults to the first SQL warehouse / catalog "jobseeker" / job "JobSeeeker"
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_JOB_NAME=
# Optional: comma-separated emails allowed to use the job data
ALLOWED_EMAILS=

# Scrapers (company list in Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
